{
  "name": "savquiz",
  "version": "2.0.0",
  "description": "Savquiz - Quiz & Exam System (Vite React + Fastify + SQLite)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite client",
    "dev:server": "tsx watch server/src/index.ts",
    "dev": "vite client",
    "build:client": "tsc -b client && vite build client",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "preview": "vite preview client --port 4173",
    "seed": "tsx server/src/db/seed.ts",
    "start": "node server/dist/index.js",
    "serve": "npm run build && npm run start"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.3",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "fastify": "^5.2.1",
    "lucide-react": "^1.44.0",
    "mathjax": "^3.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
